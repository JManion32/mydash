# ==========================================
# DEVELOPMENT ENV EXAMPLE
# ==========================================
# Copy to .env and adjust. Never commit .env.

ENV=development

# for using the Vite development server with no API
VITE_MOCK_MODE=false

# Origin the browser loads the site from.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_USERNAME=mydash
POSTGRES_PASSWORD=devpassword
POSTGRES_DB_NAME=mydash
POSTGRES_DB_HOST=db
POSTGRES_DB_PORT=5432
